# GigaChat authorization key (base64 client_id:client_secret)
GIGACHAT_AUTH_KEY=

# Alternative: separate client credentials
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=

GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Можно переопределить при необходимости:
# GIGACHAT_API_URL=https://api.giga.chat/v1/chat/completions
# GIGACHAT_MODELS_URL=https://api.giga.chat/v1/models
# false — если в контейнере нет российского корневого сертификата
GIGACHAT_VERIFY_SSL=false
